{
  "experiment": "dcnn_001",
  "seed": 42,
  "epochs": 100,
  "batch_size": 64,
  "train_setups": 6,
  "validation_setups": 1,
  "num_classes": 17,
  "input_layout": "sensors_time",
  "recurrent_activation": "softmax",
  "optimizer": "adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0,
