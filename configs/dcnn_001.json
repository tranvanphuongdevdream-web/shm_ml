  "dropout_dense": 0.0,
  "l2": 0.0,
  "mixed_precision": false,
  "use_all_gpus": false,
  "data_pipeline": "numpy",
  "early_stopping_monitor": "val_accuracy",
  "early_stopping_mode": "max",
  "early_stopping_patience": 30
}
